<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage Customer Profile"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/tvUpdCustomerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customer ID:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        android:gravity="center"/>

    <EditText
        android:id="@+id/etUpdCustomerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="First Name"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etUpdCustomerSurname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Surname"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etUpdPhoneNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:inputType="phone"
        android:layout_marginBottom="10dp"/>

    <EditText
        android:id="@+id/etUpdEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnUpdateCustomer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Update Changes"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnDeleteCustomer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Delete Customer"
        android:backgroundTint="#F44336"/>

</LinearLayout>